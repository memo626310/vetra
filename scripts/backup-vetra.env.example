# Local-only settings for scripts/backup-vetra.ps1; keep this file private.
VETRA_CORE_DB_PASSWORD=REPLACE_WITH_CORE_DATABASE_PASSWORD
# Optional pooler settings when direct DB access is unavailable:
# VETRA_CORE_DB_HOST=aws-0-region.pooler.supabase.com
# VETRA_CORE_DB_PORT=5432
# VETRA_CORE_DB_USER=postgres.projectref
# VETRA_SHARED_DATABASE_HOST=aws-0-region.pooler.supabase.com
# VETRA_SHARED_DATABASE_PORT=5432
# VETRA_SHARED_DATABASE_USER=postgres.projectref
# Optional paths if pg_dump / pg_restore are not on PATH:
# VETRA_PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# VETRA_PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe
# Optional destination override:
# VETRA_BACKUP_ROOT=C:\Users\YOUR_USER\Documents\VetraBackups
